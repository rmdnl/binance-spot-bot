# Server-side secrets only. Never expose these to browser code.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Dashboard password hash. Minimum password length enforced by application: 8.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=

# Persistence and execution safety.
DATABASE_URL=sqlite:///./data/spot_bot.db
DASHBOARD_COOKIE_SECURE=true
DEFAULT_ENVIRONMENT=testnet
ALLOW_ORDER_SUBMISSION=false

# Grid profitability assumptions (percent units, not fractions).
# Set these from your actual account fee tier; defaults are estimates, not guarantees.
GRID_MIN_NET_PROFIT_PCT=0.30
GRID_MAKER_FEE_PCT=0.10
GRID_SLIPPAGE_PCT=0.05
