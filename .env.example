# Copy to .env on the VPS. Never commit actual secrets.
APP_HOST=127.0.0.1
APP_PORT=8082
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD_HASH=
DATABASE_URL=sqlite:///./data/dca_bot.sqlite3
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
SESSION_COOKIE_SECURE=false # set true in production behind HTTPS
SESSION_MAX_AGE_SECONDS=3600
PAPER_POLL_INTERVAL_SECONDS=10
