# Server-side credentials only. Never expose these to browser code.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Generate with: python scripts/create_admin_hash.py
DASHBOARD_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SESSION_SECRET=

# Keep SQLite on persistent storage in production.
DATABASE_URL=sqlite+aiosqlite:///./data/spot_terminal.db
DASHBOARD_COOKIE_SECURE=true
